# Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# ============================================================
# SUPABASE (required for production P0)
# ============================================================
# Your Supabase project URL — safe to include in mobile app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key — safe to include in mobile app
# Row Level Security (RLS) protects data server-side
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# In Supabase Dashboard: Project Settings → API. These are intentionally public
# client credentials; security comes from Auth, RLS, and private Storage policies.
# Do not set SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY, or any provider secret here.

# ============================================================
# AI PROVIDERS (Supabase Edge Function secrets only)
# These must NEVER go in the mobile app.
# They must be server-side only (Supabase Edge Functions, etc.)
# ============================================================
# Set with: supabase secrets set OPENAI_API_KEY=...
# OPENAI_API_KEY=...          # Server-side only; never place in this file
# ANTHROPIC_API_KEY=...       # Server-side only
# OPENROUTER_API_KEY=...      # Server-side only
# GROQ_API_KEY=...            # Server-side only

# ============================================================
# RETAILER CREDENTIALS (Phase 15+)
# These must NEVER go in the mobile app.
# ============================================================
# MYNTRA_API_KEY=...          # Server-side only
# AJIO_API_KEY=...            # Server-side only

# ============================================================
# ANALYTICS (Phase 26+)
# ============================================================
# EXPO_PUBLIC_POSTHOG_KEY=...  # Client-safe analytics key
